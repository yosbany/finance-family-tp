# Firebase Configuration
# Los valores se obtienen de firebase.json automáticamente en producción
FIREBASE_PROJECT_ID=finance-family-tp

# LLM Configuration (FASE 05 y posteriores)
# NO INCLUIR valores reales aquí. Solo nombres de variables.
# Los valores se establecen como Secret Manager values en Google Cloud.

# NRD Online LLM
# NRD_LLM_BASE_URL=https://model.nrdonline.site/v1
# NRD_LLM_API_KEY=<secret in Google Cloud Secret Manager>
# NRD_LLM_MODEL=<model-name>

# Environment
NODE_ENV=development
