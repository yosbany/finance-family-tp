# Nginx virtual host for Finance Family API
# Location: /etc/nginx/sites-available/service.nrdonline.site
# Symbolic link: /etc/nginx/sites-enabled/service.nrdonline.site

upstream finance_api {
    server 127.0.0.1:8030;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name service.nrdonline.site;

    # Redirect HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name service.nrdonline.site;

    # SSL certificates (Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/service.nrdonline.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/service.nrdonline.site/privkey.pem;

    # SSL configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Logging
    access_log /var/log/nginx/finance-family-api-access.log combined;
    error_log /var/log/nginx/finance-family-api-error.log warn;

    # Reverse proxy to Node.js backend
    location / {
        proxy_pass http://finance_api;
        
        # Proxy headers
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $server_name;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # Buffering
        proxy_buffering off;
        proxy_request_buffering off;
    }
}
