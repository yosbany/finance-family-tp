# Finance Family API - Production Configuration
# Location: /etc/finance-family-api/finance-family-api.env
# Owner: root:root
# Permissions: 600

# Environment
NODE_ENV=production
PORT=8030

# Firebase Configuration
FIREBASE_PROJECT_ID=finance-family-tp
FIREBASE_DATABASE_URL=https://finance-family-tp.firebaseio.com

# Firebase Admin SDK Credentials
# MUST be set via GOOGLE_APPLICATION_CREDENTIALS environment variable
# Pointing to: /etc/finance-family-api/firebase-service-account.json
# File owner: root:root, Permissions: 600
GOOGLE_APPLICATION_CREDENTIALS=/etc/finance-family-api/firebase-service-account.json

# CORS - Allowed Origins
# GitHub Pages origin - Production deployment
ALLOWED_ORIGINS=https://yosbany.github.io

# LLM Configuration (FASE 05+)
# DO NOT enable yet. Leave empty.
# NRD_LLM_BASE_URL=https://model.nrdonline.site/v1
# NRD_LLM_API_KEY=
