# Server Configuration
NODE_ENV=development
PORT=3001

# Allowed Origins for CORS
# Development: http://localhost:5173,http://localhost:5174
# Production: https://yosbany.github.io
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://yosbany.github.io

# Firebase Configuration
FIREBASE_PROJECT_ID=finance-family-tp
FIREBASE_DATABASE_URL=https://finance-family-tp.firebaseio.com

# Firebase Admin SDK credentials
# Set via file: GOOGLE_APPLICATION_CREDENTIALS environment variable
# Or use Firebase Admin SDK default credentials
# This should point to the service account JSON file (NOT in Git)
# Example: /var/secrets/firebase-service-account.json

# LLM Configuration (FASE 05 and later)
# DO NOT include values here. Only variable names.
# Values stored only in VPS environment/secrets.
# NRD_LLM_BASE_URL=https://model.nrdonline.site/v1
# NRD_LLM_API_KEY=
